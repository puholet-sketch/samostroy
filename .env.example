# Скопируйте в `.env` (не коммитить). Публичные VITE_* попадают в клиентский бандл.

# --- Local pro-stack API (Docker: postgres + api на :8787) ---
# После: docker compose up -d
VITE_FEEDBACK_API_URL=http://127.0.0.1:8787
VITE_FEEDBACK_API_TOKEN=local-dev-token
# Алиасы (то же самое):
# VITE_API_URL=http://127.0.0.1:8787
# VITE_API_TOKEN=local-dev-token
#
# Тот же токен — FEEDBACK_TOKEN в docker-compose / bots/feedback-bot/.env
# FEEDBACK_TOKEN=local-dev-token
#
# GitHub Pages → localhost API с интернета не работает. Для Pages нужен
# публичный URL (cloudflared) или оставить только Web3Forms.

# --- Feedback email через Web3Forms (рекомендуется для GitHub Pages) ---
# 1. https://web3forms.com → создать Access Key на адрес разработчика
# 2. Подтвердить почту по письму от Web3Forms
# 3. Вставить ключ сюда или в CRM → Безопасность → Feedback email
VITE_WEB3FORMS_ACCESS_KEY=
# Куда должны приходить письма (ключ Web3Forms создаётся именно на этот ящик)
VITE_FEEDBACK_EMAIL_TO=sorvanvon@yandex.ru
