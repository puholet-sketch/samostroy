PORT=8787
FEEDBACK_TOKEN=local-dev-token

# Telegram (опционально — уведомления и кнопки статуса)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Durable store. Без URL — JSON в data/*.json
# В Docker Compose API получает DATABASE_URL сам (хост postgres).
# При запуске npm start на хосте:
DATABASE_URL=postgres://samostroy:samostroy@127.0.0.1:5433/samostroy

# Опционально: каталог PNG (по умолчанию bots/feedback-bot/data/images)
# FEEDBACK_IMAGES_DIR=
